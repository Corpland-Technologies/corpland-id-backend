{{#> layout}}
{{#*inline "title"}}{{subject}}{{/inline}}
{{#*inline "headline"}}{{headline}}{{/inline}}
{{#*inline "preheader"}}{{preheader}}{{/inline}}
{{#*inline "content"}}
<p style="margin: 0 0 16px;">Hi {{firstName name}},</p>
{{#each paragraphs}}
<p style="margin: 0 0 16px;">{{this}}</p>
{{/each}}
{{#if cta}}
{{> button label=cta.label url=cta.url}}
{{/if}}
{{#if signoff}}
<p style="margin: 24px 0 0; color: #6e6e73;">{{signoff}}</p>
{{/if}}
{{/inline}}
{{/layout}}
