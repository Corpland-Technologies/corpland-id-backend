<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>{{#> title}}Corpland{{/title}}</title>
    <!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      img { border: 0; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
      a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
      @media only screen and (max-width: 600px) {
        .container { width: 100% !important; }
        .panel { padding: 32px 24px 28px !important; }
        .content { padding: 32px 24px 36px !important; }
        .headline { font-size: 26px !important; padding-top: 32px !important; }
        .code { font-size: 32px !important; letter-spacing: 0.14em !important; padding: 18px 22px !important; }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f5f5f7; word-spacing: normal; -webkit-font-smoothing: antialiased;">
    <div id="preheader" style="display: none; max-height: 0; max-width: 0; overflow: hidden; opacity: 0; color: #f5f5f7; font-size: 1px; line-height: 1px;">{{#> preheader}}{{/preheader}}&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f5f5f7;">
      <tr>
        <td align="center" style="padding: 40px 16px 36px;">
          <table role="presentation" class="container" width="560" cellpadding="0" cellspacing="0" border="0" style="width: 560px; max-width: 560px;">
            <tr>
              <td class="panel" bgcolor="#06122e" style="background-color: #06122e; background-image: radial-gradient(62% 132% at 82% 104%, rgba(0, 100, 255, 0.62) 0%, rgba(0, 100, 255, 0.26) 38%, rgba(0, 100, 255, 0) 72%); border-radius: 24px 24px 0 0; padding: 40px 44px 36px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="40" style="width: 40px; vertical-align: middle;">
                      <img src="https://ik.imagekit.io/4hxqb9ldw/CORPLANDLOGO-NOBG.png?tr=w-80" width="40" height="40" alt="Corpland" style="display: block; width: 40px; height: 40px;" />
                    </td>
                    <td style="padding-left: 12px; vertical-align: middle; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; color: #ffffff;">
                      Corpland
                    </td>
                  </tr>
                </table>
                <div class="headline" style="padding-top: 44px; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 30px; line-height: 1.1; font-weight: 700; letter-spacing: -0.035em; color: #ffffff;">
                  {{#> headline}}Corpland{{/headline}}
                </div>
              </td>
            </tr>
            <tr>
              <td class="content" bgcolor="#ffffff" style="background-color: #ffffff; border-radius: 0 0 24px 24px; padding: 40px 44px 44px; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 17px; line-height: 1.55; color: #1d1d1f;">
                {{#> content}}{{/content}}
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 24px 24px 0; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #86868b;">
                {{#> footer}}You are receiving this because you have a Corpland ID.{{/footer}}<br />
                <a href="https://corplandtechnologies.com" style="color: #86868b; text-decoration: none;">Corpland Technologies</a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
