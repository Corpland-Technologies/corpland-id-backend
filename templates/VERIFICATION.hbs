{{#> layout}}
{{#*inline "title"}}Verify your email{{/inline}}
{{#*inline "headline"}}Verify your email.{{/inline}}
{{#*inline "preheader"}}Your Corpland code is {{otp}}{{/inline}}
{{#*inline "footer"}}Sent because this address was used to sign up for Corpland.{{/inline}}
{{#*inline "content"}}
<p style="margin: 0 0 16px;">Hi {{firstName name}},</p>
<p style="margin: 0 0 20px;">Enter this code in Corpland to confirm it is really you.</p>
{{> code otp=otp}}
<p style="margin: 0 0 12px; font-size: 13px; line-height: 1.6; color: #6e6e73;">The code expires in 30 minutes.</p>
<p style="margin: 0; font-size: 13px; line-height: 1.6; color: #6e6e73;">If you did not create a Corpland ID, you can ignore this email.</p>
{{/inline}}
{{/layout}}
