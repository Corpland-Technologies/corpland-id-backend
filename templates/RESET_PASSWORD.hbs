{{#> layout}}
{{#*inline "title"}}Reset your password{{/inline}}
{{#*inline "headline"}}Reset your password.{{/inline}}
{{#*inline "preheader"}}Your Corpland reset code is {{otp}}{{/inline}}
{{#*inline "footer"}}Sent because a password reset was requested for this address.{{/inline}}
{{#*inline "content"}}
<p style="margin: 0 0 16px;">Hi {{firstName name}},</p>
<p style="margin: 0 0 20px;">Use this code to choose a new password.</p>
{{> code otp=otp}}
<p style="margin: 0 0 12px; font-size: 13px; line-height: 1.6; color: #6e6e73;">The code expires in 30 minutes.</p>
<p style="margin: 0; font-size: 13px; line-height: 1.6; color: #6e6e73;">If you did not ask to reset your password, ignore this email and your password stays the same.</p>
{{/inline}}
{{/layout}}
