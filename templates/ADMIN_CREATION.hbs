{{#> layout}}
{{#*inline "title"}}Your admin access is ready{{/inline}}
{{#*inline "headline"}}Your admin access is ready.{{/inline}}
{{#*inline "preheader"}}Sign in to Corpland with the details inside.{{/inline}}
{{#*inline "footer"}}Sent because admin access was created for this address.{{/inline}}
{{#*inline "content"}}
<p style="margin: 0 0 16px;">Hi {{firstName name}},</p>
<p style="margin: 0 0 20px;">Sign in with the details below and change the password the first time you sign in.</p>
{{> details rows=rows}}
{{> button label="Sign in" url=signInUrl}}
<p style="margin: 16px 0 0; font-size: 13px; line-height: 1.6; color: #6e6e73;">Keep this email private. Anyone with these details can sign in as you.</p>
{{/inline}}
{{/layout}}
